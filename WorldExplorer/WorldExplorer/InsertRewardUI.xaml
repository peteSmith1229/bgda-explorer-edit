<Window x:Class="WorldExplorer.InsertRewardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorldExplorer.Controls"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Insert Reward" Height="540" Width="720" MinHeight="380" MinWidth="560">
    <Window.Resources>
        <Style x:Key="CellTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style x:Key="CellComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style x:Key="Step" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <Border DockPanel.Dock="Top" Style="{StaticResource Callout}">
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Text="The rewards run just before the chosen call, which then runs unchanged — the original behaviour still happens. Anchor on an event that occurs when you want the reward (a line of dialogue, a spawn…). Reward functions the script doesn't import yet are added automatically." />
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="1 · ANCHOR CALL" Style="{StaticResource Step}" />
        <ComboBox x:Name="anchorCombo" DockPanel.Dock="Top" DisplayMemberPath="Display" />
        <TextBlock x:Name="noAnchorsText" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,6,0,0" FontSize="12"
                   Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                   Text="No call in this script has a layout that can safely take a reward." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="insertButton" Content="Insert" MinWidth="90" IsDefault="True"
                    Style="{StaticResource Button.Accent}" Click="Insert_Click" />
            <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,14,0,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="Add reward"
                    controls:ControlAssist.Icon="{StaticResource Icon.Add}" Click="AddReward_Click" />
            <TextBlock Text="2 · REWARDS" Style="{StaticResource Step}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid x:Name="rewardGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                  HeadersVisibility="Column" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Reward" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource CellComboBox}" ItemsSource="{Binding CallOptions}"
                                      SelectedItem="{Binding ExternalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Amount / item name" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource CellTextBox}"
                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
