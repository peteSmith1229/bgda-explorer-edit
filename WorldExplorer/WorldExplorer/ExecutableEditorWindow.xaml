<Window x:Class="WorldExplorer.ExecutableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Executable Tuning" Height="620" Width="1080"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Edits the game executable (PAL SLES-506.72). Changes apply to NEW characters and future level-ups. Save writes a modified executable — keep a backup of your original." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save As…" Width="100" Margin="0,0,8,0" Click="SaveAs_Click" />
            <Button Content="Close" Width="90" IsCancel="True" />
        </StackPanel>

        <TabControl>
            <TabItem Header="XP per Level">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Total XP required to reach each level. Must start at 0 and strictly increase. Lower values = faster leveling." />
                    <DataGrid x:Name="xpGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="XP required" Width="*"
                                                Binding="{Binding Xp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Starting Stats">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Starting ability scores per class (1–30). Applied when a NEW character of that class is created." />
                    <DataGrid x:Name="statsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" IsReadOnly="True" Width="170" />
                            <DataGridTextColumn Header="STR" Width="*"
                                                Binding="{Binding STR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="INT" Width="*"
                                                Binding="{Binding INT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="WIS" Width="*"
                                                Binding="{Binding WIS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="DEX" Width="*"
                                                Binding="{Binding DEX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="CON" Width="*"
                                                Binding="{Binding CON, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="CHA" Width="*"
                                                Binding="{Binding CHA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Feats &amp; Spells">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Energy cost, damage range, and effect colours for each feat/spell. A ★ marks spells whose Damage Min/Max change real combat damage (your character's stats add a spread on top — e.g. INT gives fireball ±5). For other spells the damage columns are secondary (multi-projectile spells, per-second channels and charge moves handle damage differently). Glow = the aura over the caster's hands (0–255). Light = the colour that effect casts on the environment (0–65535; some spells ship above 255). Channeled spells bill energy per frame; the /sec figure shown is that ×50. Coefficient is a per-level scaling value whose effect is still under investigation." />
                    <DataGrid x:Name="featGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" ColumnHeaderHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Feat / Spell (★ = live damage)" Binding="{Binding DisplayName}" IsReadOnly="True" Width="200" />
                            <DataGridTextColumn Header="Energy" Width="70"
                                                Binding="{Binding Energy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="/sec" Binding="{Binding PerSecond}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="Dmg Min" Width="75"
                                                Binding="{Binding DamageMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Dmg Max" Width="75"
                                                Binding="{Binding DamageMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Glow R" Width="55"
                                                Binding="{Binding GlowR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Glow G" Width="55"
                                                Binding="{Binding GlowG, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Glow B" Width="55"
                                                Binding="{Binding GlowB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Light R" Width="55"
                                                Binding="{Binding LightR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Light G" Width="55"
                                                Binding="{Binding LightG, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Light B" Width="55"
                                                Binding="{Binding LightB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Coef." Width="60"
                                                Binding="{Binding Coefficient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
