<Window x:Class="WorldExplorer.ExecutableEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Executable Tuning (XP &amp; Starting Stats)" Height="560" Width="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
            Text="Edits the game executable (PAL SLES-506.72). Changes apply to NEW characters / future level-ups. Save writes a modified executable — keep a backup of your original."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save As…" Width="100" Margin="0,0,8,0" Click="SaveAs_Click"/>
            <Button Content="Close" Width="90" IsCancel="True"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="XP per Level">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                        Text="Total XP required to reach each level. Must start at 0 and strictly increase. Lower values = faster leveling."/>
                    <DataGrid x:Name="xpGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="XP required" Width="*"
                                Binding="{Binding Xp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Starting Stats">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                        Text="Starting ability scores per class (1–30). Applied when a NEW character of that class is created."/>
                    <DataGrid x:Name="statsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" IsReadOnly="True" Width="170"/>
                            <DataGridTextColumn Header="STR" Binding="{Binding STR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="INT" Binding="{Binding INT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="WIS" Binding="{Binding WIS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="DEX" Binding="{Binding DEX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="CON" Binding="{Binding CON, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="CHA" Binding="{Binding CHA, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            
                        <TabItem Header="Feats &amp; Spells">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                        Text="Energy cost, effect colour, and the displayed range for each feat/spell. Channeled spells bill energy per frame; the /sec figure the game shows is this ×50. NOTE: the in-game combat DAMAGE is computed per character at cast time and is not editable here — changing the range only affects the tooltip text."/>
                    <DataGrid x:Name="featGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Feat / Spell" Binding="{Binding Name}" IsReadOnly="True" Width="170"/>
                            <DataGridTextColumn Header="Energy" Width="80"
                                Binding="{Binding Energy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="/sec" Binding="{Binding PerSecond}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="Range Min" Width="80"
                                Binding="{Binding RangeMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Range Max" Width="80"
                                Binding="{Binding RangeMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="R" Binding="{Binding R, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                            <DataGridTextColumn Header="G" Binding="{Binding G, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                            <DataGridTextColumn Header="B" Binding="{Binding B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            
        </TabControl>
    </DockPanel>
</Window>