<Window x:Class="WorldExplorer.Da2IsoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorldExplorer.Controls"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Build Three-Player ISO — Dark Alliance II" Height="660" Width="940" MinHeight="460" MinWidth="680"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="Path" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style x:Key="Browse" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="Browse…" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,14,20,16">
        <Border DockPanel.Dock="Top" Style="{StaticResource Callout}" Margin="0,0,0,10">
            <DockPanel>
                <controls:GeometryIcon Data="{StaticResource Icon.Info}" Margin="0,1,10,0" VerticalAlignment="Top"
                                       Fill="{DynamicResource Brush.Accent}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Text="Makes the [3P] copy of the Dark Alliance II disc image (USA, SLUS_206.75 v1.03) that the three-player mod plays from: the original image plus, in its BG\0MOD folder, the multitap driver and the Dark Alliance 1 files the DA1 heroes and bosses use. The original image is only read; a [3P] copy that already exists is updated (files already on it are skipped). Close PCSX2 first." />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="buildButton" Content="Build" MinWidth="110" Style="{StaticResource Button.Accent}"
                        controls:ControlAssist.Icon="{StaticResource Icon.Kind.Archive}" Click="Build_Click" />
                <Button x:Name="cancelButton" Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click" />
                <Button x:Name="closeButton" Content="Close" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
            <ProgressBar x:Name="progress" Height="6" Margin="0,0,16,0" VerticalAlignment="Center" Visibility="Hidden" IsIndeterminate="True" />
        </DockPanel>

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Original ISO" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="isoBox" Style="{StaticResource Path}" TextChanged="IsoBox_TextChanged" />
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Browse}" Click="BrowseIso_Click" />
            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="[3P] ISO" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="outputBox" Style="{StaticResource Path}" />
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Browse}" Click="BrowseOutput_Click" />
            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Champions of Norrath files" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="norrathBox" Style="{StaticResource Path}" TextChanged="Folder_TextChanged"
                     ToolTip="The folder with Champions of Norrath's disc files (the one holding BG\0MOD\MTAPMAN.IRX)" />
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Browse}" Tag="norrath" Click="BrowseFolder_Click" />
            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Dark Alliance files" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="da1Box" Style="{StaticResource Path}" TextChanged="Folder_TextChanged"
                     ToolTip="The folder with Dark Alliance 1's disc files (the one holding BG\DATA)" />
            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource Browse}" Tag="da1" Click="BrowseFolder_Click" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}" Margin="0,10,0,6" Text="The files are found in the two folders of extracted disc files (BG\0MOD and BG\DATA in them, or the folders themselves); a file can also be picked by hand. Only the multitap driver is needed for three players: the DA1 files are for the DA1 heroes (Vahn, Kromlech and their voices) and the DA1 bosses on the Creatures tab of Executable Tuning." />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="80" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="fileGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Add" Width="46" Binding="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="On the disc" Binding="{Binding NameOnDisc}" IsReadOnly="True" Width="110" />
                    <DataGridTextColumn Header="What" Binding="{Binding What}" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Header="From" Binding="{Binding From}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="File" Width="2*" Binding="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="…" Padding="8,0" Margin="2" Click="BrowseFile_Click" ToolTip="Pick the file" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" Text="LOG" Style="{StaticResource Text.Section}" FontSize="11" Margin="0,12,0,6" />
            <TextBox Grid.Row="2" x:Name="logBox" Style="{StaticResource TextBox.Code}" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>
