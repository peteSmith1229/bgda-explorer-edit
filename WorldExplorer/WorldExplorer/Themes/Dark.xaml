<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Dark colour tokens. Every key here must also exist in Light.xaml: the
        ThemeManager swaps the whole dictionary and controls reference these
        keys through DynamicResource.
    -->

    <!-- ── Raw colours (used where a Color rather than a Brush is needed) ── -->
    <Color x:Key="Color.Accent">#FF3D8BFD</Color>
    <Color x:Key="Color.Shadow">#99000000</Color>
    <Color x:Key="Color.ViewportTop">#FF2B2E35</Color>
    <Color x:Key="Color.ViewportBottom">#FF18191C</Color>

    <!-- ── Surfaces ── -->
    <SolidColorBrush x:Key="Brush.Window" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="Brush.Chrome" Color="#FF25262A" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF2B2D30" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF313338" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="#FF2F3136" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#E6232428" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#99101113" />
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#0DFFFFFF" />

    <!-- ── Lines ── -->
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3C3F45" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF4D5057" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#FF35373C" />

    <!-- ── Text ── -->
    <SolidColorBrush x:Key="Brush.Text" Color="#FFE3E5E8" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFA3A8B0" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF7A7F87" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#FF5F636A" />

    <!-- ── Interactive ── -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF3D8BFD" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF5C9DFF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF2F74DB" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#333D8BFD" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Control" Color="#FF35373C" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#FF3E4046" />
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#FF2E3034" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#FF2D4A72" />
    <SolidColorBrush x:Key="Brush.SelectionInactive" Color="#FF3A3D43" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#FF45484E" />
    <SolidColorBrush x:Key="Brush.Track" Color="#FF45484E" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#80FFFFFF" />

    <!-- ── Status ── -->
    <SolidColorBrush x:Key="Brush.Success" Color="#FF3FB950" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFE3A33B" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF0564F" />
    <SolidColorBrush x:Key="Brush.Info" Color="#FF3D8BFD" />
    <SolidColorBrush x:Key="Brush.Modified" Color="#FFE3A33B" />

    <!-- ── 3D viewports ── -->
    <LinearGradientBrush x:Key="Brush.Viewport" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FF2B2E35" />
        <GradientStop Offset="1" Color="#FF18191C" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.ViewportText" Color="#FFE3E5E8" />

    <!-- ── File-type icon colours ── -->
    <SolidColorBrush x:Key="Brush.Icon.Gob" Color="#FFE8B04B" />
    <SolidColorBrush x:Key="Brush.Icon.Archive" Color="#FFCFA35E" />
    <SolidColorBrush x:Key="Brush.Icon.Folder" Color="#FF8FA3B8" />
    <SolidColorBrush x:Key="Brush.Icon.Texture" Color="#FFC586C0" />
    <SolidColorBrush x:Key="Brush.Icon.Model" Color="#FF4FC1FF" />
    <SolidColorBrush x:Key="Brush.Icon.Animation" Color="#FFFFA657" />
    <SolidColorBrush x:Key="Brush.Icon.World" Color="#FF7EC27E" />
    <SolidColorBrush x:Key="Brush.Icon.Script" Color="#FFDCDCAA" />
    <SolidColorBrush x:Key="Brush.Icon.Audio" Color="#FFF28FAD" />
    <SolidColorBrush x:Key="Brush.Icon.Objects" Color="#FF4EC9B0" />
    <SolidColorBrush x:Key="Brush.Icon.Text" Color="#FF9CDCFE" />
    <SolidColorBrush x:Key="Brush.Icon.Database" Color="#FFB8A2F0" />
    <SolidColorBrush x:Key="Brush.Icon.Data" Color="#FF9DA5B4" />
    <SolidColorBrush x:Key="Brush.Icon.Missing" Color="#FFF0564F" />

    <!--
        System colour overrides: any control left on its default (Aero2)
        template — e.g. the editing TextBox inside a DataGrid cell — reads these
        through DynamicResource, so it follows the theme too.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE3E5E8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2B2D30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE3E5E8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF3C3F45" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF45484E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF5F636A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF7A7F87" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF7A7F87" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF2D4A72" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A3D43" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE3E5E8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF2F3136" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF25262A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE3E5E8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#FF2D4A72" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FF2F3136" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFE3E5E8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="#FF5C9DFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#FF3C3F45" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="#FF3C3F45" />
</ResourceDictionary>
