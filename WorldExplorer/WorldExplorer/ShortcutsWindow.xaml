<Window x:Class="WorldExplorer.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Keyboard Shortcuts" Width="720" Height="620" MinWidth="560" MinHeight="400"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <DockPanel Margin="22,18,22,16">
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                MinWidth="90" Margin="0,14,0,0" Click="Close_Click" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Groups" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="11" />
                            <Border Style="{StaticResource Card}" Padding="14,8">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource KeyChip}" HorizontalAlignment="Left" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Keys}" FontSize="12" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Action}" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
