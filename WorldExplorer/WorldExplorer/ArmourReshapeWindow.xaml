<Window x:Class="WorldExplorer.ArmourReshapeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hvd="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Core.Wpf"
        xmlns:controls="clr-namespace:WorldExplorer.Controls"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Reshape" Width="1060" MinWidth="900" SizeToContent="Height" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Width" Value="64" />
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="516" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Settings -->
        <StackPanel>
            <TextBlock x:Name="headerText" Style="{StaticResource Text.Subtitle}" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,10"
                       Text="Scales the piece about its own centre (a pair of gloves or boots: each one about its own), then pushes its surface out along its normals. The armour still follows the skeleton. Export Shape as OBJ for any other change." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <TextBlock Text="Width (left to right)" Style="{StaticResource Label}" />
                <Slider x:Name="xSlider" Grid.Column="1" Minimum="50" Maximum="250" Value="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
                <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=xSlider, StringFormat={}{0:0}%}" />

                <TextBlock Grid.Row="1" Text="Depth (front to back)" Style="{StaticResource Label}" />
                <Slider x:Name="ySlider" Grid.Row="1" Grid.Column="1" Minimum="50" Maximum="250" Value="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=ySlider, StringFormat={}{0:0}%}" />

                <TextBlock Grid.Row="2" Text="Height" Style="{StaticResource Label}" />
                <Slider x:Name="zSlider" Grid.Row="2" Grid.Column="1" Minimum="50" Maximum="250" Value="100" TickFrequency="5"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=zSlider, StringFormat={}{0:0}%}" />

                <TextBlock Grid.Row="3" Text="Bulk (push out)" Style="{StaticResource Label}" />
                <Slider x:Name="inflateSlider" Grid.Row="3" Grid.Column="1" Minimum="-1" Maximum="4" Value="0" TickFrequency="0.25"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=inflateSlider, StringFormat={}{0:0.00} units}" />
            </Grid>
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="The human is about 76 units tall. For a pair, width and depth are of each piece; with the arms out (the model's pose), gloves run left to right along the arm." />

            <TextBlock Text="Characters" Style="{StaticResource Text.Section}" />
            <WrapPanel x:Name="characterPanel" />
            <TextBlock x:Name="sizeText" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Live preview: the reshaped piece as WorldExplorer's model view would show it -->
        <DockPanel Grid.Column="1" Margin="22,0,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Preview" Style="{StaticResource Label}" />
                <ComboBox x:Name="previewBox" Width="120" VerticalAlignment="Center" />
                <CheckBox x:Name="originalBox" Content="Show the original" Margin="16,0,0,0" VerticalAlignment="Center"
                          ToolTip="Show the piece as it is now, to compare (the camera stays where it is)" />
                <CheckBox x:Name="wearerBox" Content="Show the wearer" Margin="16,0,0,0" VerticalAlignment="Center"
                          ToolTip="Draw the character's own body and hair under the piece, without the parts it hides" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Drag to turn, scroll to zoom, middle-drag to pan." />
            <TextBlock x:Name="previewText" DockPanel.Dock="Bottom" Style="{StaticResource Text.Secondary}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <Border Background="{DynamicResource Brush.Viewport}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="6" MinHeight="340">
                <Grid>
                    <hvd:HelixViewport3D x:Name="viewport" ClipToBounds="True" IsChangeFieldOfViewEnabled="False"
                                         ShowViewCube="False" ShowCoordinateSystem="True">
                        <hvd:SunLight />

                        <ModelVisual3D x:Name="previewObject" />
                    </hvd:HelixViewport3D>
                    <Border Style="{StaticResource OverlayPanel}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                        <Button Style="{StaticResource Button.Subtle}" Click="Frame_Click"
                                controls:ControlAssist.Icon="{StaticResource Icon.Frame}" ToolTip="Frame the piece" />
                    </Border>
                </Grid>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="okButton" Content="Reshape" MinWidth="90" IsDefault="True"
                    Style="{StaticResource Button.Accent}" Click="OkButton_Click" />
            <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
