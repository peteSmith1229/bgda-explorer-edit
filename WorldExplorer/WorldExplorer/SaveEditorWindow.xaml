<Window x:Class="WorldExplorer.SaveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Save (Difficulty)" Height="360" Width="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Edit the difficulty of each save slot in a PS2 memory-card export (.psu). Difficulty is per character/save. Save writes a modified .psu — keep a backup of your original card. Re-import the .psu to your memory card with your card-transfer tool." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save As…" Width="100" Margin="0,0,8,0" Click="SaveAs_Click" />
            <Button Content="Close" Width="90" IsCancel="True" />
        </StackPanel>

        <DataGrid x:Name="slotGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Slot" Binding="{Binding SlotNumber}" IsReadOnly="True" Width="55" />
                <DataGridTextColumn Header="Character" Binding="{Binding CharacterName}" IsReadOnly="True" Width="140" />
                <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" IsReadOnly="True" Width="120" />
                <DataGridComboBoxColumn x:Name="difficultyColumn" Header="Difficulty" Width="*"
                                        SelectedItemBinding="{Binding DifficultyText, Mode=TwoWay}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
