<Window x:Class="WorldExplorer.SaveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorldExplorer.Controls"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Save Game Editor" Height="520" Width="1120" MinHeight="380" MinWidth="760">
    <Window.Resources>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,14,20,16">
        <Border DockPanel.Dock="Top" Style="{StaticResource Callout}" Margin="0,0,0,6">
            <DockPanel>
                <controls:GeometryIcon Data="{StaticResource Icon.Warning}" Margin="0,1,10,0" VerticalAlignment="Top"
                                       Fill="{DynamicResource Brush.Warning}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Text="Edit a PS2 memory-card export (.psu). Changes are written to a new file — keep a backup of your original card, then re-import with your card-transfer tool." />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Save As…" MinWidth="110" Style="{StaticResource Button.Accent}"
                    controls:ControlAssist.Icon="{StaticResource Icon.Save}" Click="SaveAs_Click" />
            <Button Content="Close" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <TabControl>
            <TabItem Header="Difficulty">
                <DockPanel Margin="0,2,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}" Text="The difficulty each save slot plays at. Enemy HP in the save scales with it." />
                    <DataGrid x:Name="slotGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding SlotNumber}" IsReadOnly="True" Width="55" />
                            <DataGridTextColumn Header="Character" Binding="{Binding CharacterName}" IsReadOnly="True" Width="140" />
                            <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" IsReadOnly="True" Width="120" />
                            <DataGridComboBoxColumn x:Name="difficultyColumn" Header="Difficulty" Width="*"
                                                    SelectedItemBinding="{Binding DifficultyText, Mode=TwoWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Character">
                <DockPanel Margin="0,2,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}" Text="Level 1-16, ability scores 1-99. HP and MP are worked out by the game when the save loads." />
                    <Expander DockPanel.Dock="Top" Header="Details: how scores, HP and feat points are stored" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Help}" Text="Ability scores persist through a load (confirmed in-game). Each score is stored three times - base (original rolled score), current (effective, including points you spent and equipment), and display - and all three are written so the value you enter becomes both. Level 1-16, scores 1-99." />
                            <TextBlock Style="{StaticResource Help}" Text="HP/MP are read-only: the engine derives them on load as level x (class base + CON modifier) — e.g. level 5, CON 14 gives 70 HP. Raise CON or Level to raise HP." />
                            <TextBlock Style="{StaticResource Help}" Text="NOTE: raising Level grants ability points (one per 4 levels) but does NOT grant feat points - those come from the runtime level-up routine. Set Feat Pts directly if you want them." />
                        </StackPanel>
                    </Expander>
                    <DataGrid x:Name="characterGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot"   Binding="{Binding SlotNumber}"   IsReadOnly="True" Width="45" />
                            <DataGridTextColumn Header="Name"   Binding="{Binding Name}"         IsReadOnly="True" Width="95" />
                            <DataGridTextColumn Header="Level"  Binding="{Binding LevelText, Mode=TwoWay}"  Width="55" />
                            <DataGridTextColumn Header="XP"     Binding="{Binding XpText, Mode=TwoWay}"     Width="75" />
                            <DataGridTextColumn Header="STR"    Binding="{Binding StrText, Mode=TwoWay}"    Width="50" />
                            <DataGridTextColumn Header="INT"    Binding="{Binding IntText, Mode=TwoWay}"    Width="50" />
                            <DataGridTextColumn Header="WIS"    Binding="{Binding WisText, Mode=TwoWay}"    Width="50" />
                            <DataGridTextColumn Header="DEX"    Binding="{Binding DexText, Mode=TwoWay}"    Width="50" />
                            <DataGridTextColumn Header="CON"    Binding="{Binding ConText, Mode=TwoWay}"    Width="50" />
                            <DataGridTextColumn Header="CHA"    Binding="{Binding ChaText, Mode=TwoWay}"    Width="50" />
                            <DataGridTextColumn Header="HP"     Binding="{Binding HpCurrentText}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="HP Max" Binding="{Binding HpMaxText}" IsReadOnly="True"  Width="65" />
                            <DataGridTextColumn Header="MP"     Binding="{Binding MpCurrentText}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="MP Max" Binding="{Binding MpMaxText}" IsReadOnly="True"  Width="65" />
                            <DataGridTextColumn Header="Gold"   Binding="{Binding GoldText, Mode=TwoWay}"   Width="80" />
                            <DataGridTextColumn Header="Feat Pts" Binding="{Binding FeatPointsText, Mode=TwoWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Enemies">
                <DockPanel Margin="0,2,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}" Text="Enemy HP can be edited (1-9999). Confirmed in-game on Rats and Kobolds." />
                    <Expander DockPanel.Dock="Top" Header="Details: difficulty scaling and dead enemies" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Help}" Text="IMPORTANT: enemy HP is scaled by the save's difficulty, and randomised per instance. In CELLAR1 a Rat has 1-2 HP on Easy but 31-44 on Extreme, and a Spider 19-20 on Easy but 311-415 on Extreme — so check the Difficulty tab before deciding what a given value means." />
                            <TextBlock Style="{StaticResource Help}" Text="Enemies already killed in this save are shown greyed with 'dead' and cannot be edited: reviving requires resizing the record, which corrupts the level." />
                        </StackPanel>
                    </Expander>
                    <DataGrid x:Name="enemyGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding SlotNumber}" IsReadOnly="True" Width="45" />
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" IsReadOnly="True" Width="80" />
                            <DataGridTextColumn Header="Type ID" Binding="{Binding TypeId}" IsReadOnly="True" Width="60" />
                            <DataGridTextColumn Header="HP" Binding="{Binding HpText, Mode=TwoWay}" Width="70" />
                            <DataGridTextColumn Header="State" Binding="{Binding StateText}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="Position" Binding="{Binding Position}" IsReadOnly="True" Width="190" />
                            <DataGridTextColumn Header="Record" Binding="{Binding RecordText}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
