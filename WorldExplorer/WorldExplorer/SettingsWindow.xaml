<Window x:Class="WorldExplorer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WorldExplorer.Controls"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,8,24,18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" MinWidth="90"
                    Style="{StaticResource Button.Accent}" Click="SaveButton_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" Click="CancelButton_Click" />
        </StackPanel>

        <StackPanel>
            <!-- ── Game ── -->
            <TextBlock Text="GAME" Style="{StaticResource Heading}" />
            <ComboBox x:Name="engineVersionBox" DisplayMemberPath="Name" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="The game your files come from: it decides how levels, models and textures are decoded. Tools that only work with Dark Alliance (executable tuning, save editing, script rewards) are hidden for the other games." />

            <!-- ── Appearance ── -->
            <TextBlock Text="APPEARANCE" Style="{StaticResource Heading}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="darkThemeRadio" Content="Dark" GroupName="Theme" Margin="0,0,20,0" />
                <RadioButton x:Name="lightThemeRadio" Content="Light" GroupName="Theme" />
            </StackPanel>

            <!-- ── Files ── -->
            <TextBlock Text="FILES" Style="{StaticResource Heading}" />
            <TextBlock Text="Game data folder" Margin="0,0,0,4" Foreground="{DynamicResource Brush.TextSecondary}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseButton_Click" />
                <TextBox x:Name="dataPathTextblock" controls:ControlAssist.Placeholder="e.g. D:\BGDA\DATA" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="The Open dialog starts here." />
            <CheckBox x:Name="reopenLastFileCheckBox" Content="Reopen the last file when WorldExplorer starts"
                      Margin="0,12,0,0" />

            <!-- ── Textures ── -->
            <TextBlock Text="TEXTURES" Style="{StaticResource Heading}" />
            <CheckBox x:Name="forceOpaqueCheckBox" Content="Force opaque (ignore alpha)" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Draws every texture fully opaque. Useful for seeing colour data hidden behind transparent pixels." />

            <!-- ── Level editor ── -->
            <TextBlock Text="LEVEL EDITOR" Style="{StaticResource Heading}" />
            <DockPanel>
                <TextBlock Text="Gizmo size" VerticalAlignment="Center" Margin="0,0,14,0"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock DockPanel.Dock="Right" Width="40" VerticalAlignment="Center" TextAlignment="Right"
                           Text="{Binding Value, ElementName=gizmoSizeSlider, StringFormat={}{0:0.0}×}" />
                <Slider x:Name="gizmoSizeSlider" Minimum="0.5" Maximum="10" TickFrequency="0.5"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
