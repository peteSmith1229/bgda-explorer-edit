<Window x:Class="WorldExplorer.ArmourRecolourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Recolour" Width="620" SizeToContent="Height" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Width" Value="56" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="headerText" Style="{StaticResource Text.Subtitle}" />
        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,10"
                   Text="Turns the colours in a range of hues to other hues, and makes them more or less vivid and bright. Only the palette changes: shading and shapes stay." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Before" Style="{StaticResource Text.Caption}" />
                <Border Height="170" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                    <Image x:Name="beforeImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="afterCaption" Text="After" Style="{StaticResource Text.Caption}" />
                <Border Height="170" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                    <Image x:Name="afterImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <TextBlock Text="Turn hues by" Style="{StaticResource Label}" />
            <Slider x:Name="shiftSlider" Grid.Column="1" Minimum="-180" Maximum="180" Value="0" TickFrequency="1"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=shiftSlider, StringFormat={}{0:0}°}" />

            <TextBlock Grid.Row="1" Text="Colours from hue" Style="{StaticResource Label}" />
            <Slider x:Name="fromSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="360" Value="0" TickFrequency="1"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=fromSlider, StringFormat={}{0:0}°}" />

            <TextBlock Grid.Row="2" Text="to hue" Style="{StaticResource Label}" />
            <Slider x:Name="toSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="360" Value="360" TickFrequency="1"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=toSlider, StringFormat={}{0:0}°}" />

            <TextBlock Grid.Row="3" Text="Leave greys below" Style="{StaticResource Label}" />
            <Slider x:Name="minSatSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="0.15" TickFrequency="0.01"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=minSatSlider, StringFormat={}{0:P0}}" />

            <TextBlock Grid.Row="4" Text="Vividness" Style="{StaticResource Label}" />
            <Slider x:Name="satSlider" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="3" Value="1" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=satSlider, StringFormat={}{0:0.00}×}" />

            <TextBlock Grid.Row="5" Text="Brightness" Style="{StaticResource Label}" />
            <Slider x:Name="valSlider" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="3" Value="1" TickFrequency="0.05"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="AnyValueChanged" />
            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=valSlider, StringFormat={}{0:0.00}×}" />
        </Grid>
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                   Text="Hues: 0° red, 60° yellow, 120° green, 180° cyan, 240° blue, 300° magenta. A range like 330° to 30° wraps through red." />

        <TextBlock Text="Characters" Style="{StaticResource Text.Section}" />
        <WrapPanel x:Name="characterPanel" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="okButton" Content="Recolour" MinWidth="90" IsDefault="True"
                    Style="{StaticResource Button.Accent}" Click="OkButton_Click" />
            <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
