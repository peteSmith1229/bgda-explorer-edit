<Window x:Class="WorldExplorer.ArmourBodyPartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Hidden Body Parts" Width="440" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="headerText" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,10"
                   Text="While this piece is worn, the ticked parts of the character's own body aren't drawn. Hide what the armour covers, so nothing pokes through; show what it leaves bare. Any helmet also hides the hair." />
        <UniformGrid x:Name="partsPanel" Columns="2" />
        <TextBlock x:Name="otherBitsText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="OK" MinWidth="90" IsDefault="True" Style="{StaticResource Button.Accent}" Click="OkButton_Click" />
            <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
