<UserControl x:Class="WorldExplorer.LevelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hvd="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Core.Wpf"
             xmlns:local="clr-namespace:WorldExplorer"
             xmlns:controls="clr-namespace:WorldExplorer.Controls"
             d:DataContext="{d:DesignInstance Type=local:LevelViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- One row of the controls help: [key chip] description -->
        <Style x:Key="HelpKey" TargetType="Border" BasedOn="{StaticResource KeyChip}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,12,6" />
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ── 3D view ── -->
        <Grid Background="{DynamicResource Brush.Viewport}">
            <Border Background="Transparent" Name="trackballSource">
                <hvd:HelixViewport3D ClipToBounds="True" Name="viewport" IsChangeFieldOfViewEnabled="False"
                                     IsInertiaEnabled="False" UpDownPanSensitivity="10"
                                     LeftRightPanSensitivity="10" RotateAroundMouseDownPoint="True"
                                     ShowCoordinateSystem="True" ShowViewCube="False" CalculateCursorPosition="True">
                    <hvd:HelixViewport3D.DefaultCamera>
                        <PerspectiveCamera Position="-106,79,89" LookDirection="1,0,1" UpDirection="0,0,1" FieldOfView="50"
                                           NearPlaneDistance="0.001" />
                    </hvd:HelixViewport3D.DefaultCamera>
                    <local:SceneVisual3D Scene="{Binding Scene}" />
                </hvd:HelixViewport3D>
            </Border>

            <!-- View tools -->
            <Border Style="{StaticResource OverlayPanel}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource ToggleButton.Subtle}"
                                  IsChecked="{Binding EnableLevelSpecifiedLights, Mode=TwoWay}"
                                  controls:ControlAssist.Icon="{StaticResource Icon.Light}"
                                  ToolTip="Use the level's own lights (L). Turning this off can make big levels faster." />
                    <Button Style="{StaticResource Button.Subtle}" Click="Frame_Click"
                            controls:ControlAssist.Icon="{StaticResource Icon.Frame}" ToolTip="Frame the whole level (Ctrl+Home)" />
                    <ToggleButton x:Name="HelpToggle" Style="{StaticResource ToggleButton.Subtle}"
                                  controls:ControlAssist.Icon="{StaticResource Icon.Help}" ToolTip="Mouse and keyboard controls" />
                    <Separator Width="1" Height="18" Margin="4,0" />
                    <ToggleButton x:Name="PropertiesToggle" Style="{StaticResource ToggleButton.Subtle}" IsChecked="True"
                                  controls:ControlAssist.Icon="{StaticResource Icon.PanelRight}" ToolTip="Properties panel" />
                </StackPanel>
            </Border>

            <!-- Controls help -->
            <Border Style="{StaticResource OverlayPanel}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,62,12,0" Padding="16,12,16,8"
                    Visibility="{Binding IsChecked, ElementName=HelpToggle, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="Controls" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Border Grid.Row="1" Style="{StaticResource HelpKey}"><TextBlock Text="Left drag" FontSize="11" /></Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource HelpText}" Text="Rotate the view" />
                    <Border Grid.Row="2" Style="{StaticResource HelpKey}"><TextBlock Text="Middle drag" FontSize="11" /></Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource HelpText}" Text="Pan" />
                    <Border Grid.Row="3" Style="{StaticResource HelpKey}"><TextBlock Text="Wheel · PgUp/PgDn" FontSize="11" /></Border>
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource HelpText}" Text="Zoom" />
                    <Border Grid.Row="4" Style="{StaticResource HelpKey}"><TextBlock Text="W A S D" FontSize="11" /></Border>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource HelpText}" Text="Move the camera" />
                    <Border Grid.Row="5" Style="{StaticResource HelpKey}"><TextBlock Text="Ctrl+click" FontSize="11" /></Border>
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource HelpText}" Text="Select an object or element" />
                    <Border Grid.Row="6" Style="{StaticResource HelpKey}"><TextBlock Text="Drag gizmo" FontSize="11" /></Border>
                    <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource HelpText}" Text="Move (arrows) / rotate (rings)" />
                    <Border Grid.Row="7" Style="{StaticResource HelpKey}"><TextBlock Text="Ctrl+C · Ctrl+V" FontSize="11" /></Border>
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource HelpText}" Text="Copy / paste object (at the cursor)" />
                    <Border Grid.Row="8" Style="{StaticResource HelpKey}"><TextBlock Text="Ctrl+D · Del" FontSize="11" /></Border>
                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource HelpText}" Text="Duplicate / delete selection" />
                    <Border Grid.Row="9" Style="{StaticResource HelpKey}"><TextBlock Text="Ctrl+Z · Ctrl+Y" FontSize="11" /></Border>
                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource HelpText}" Text="Undo / redo" />
                    <Border Grid.Row="10" Style="{StaticResource HelpKey}"><TextBlock Text="L · double middle-click" FontSize="11" /></Border>
                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource HelpText}" Text="Toggle lighting · reset view" />
                </Grid>
            </Border>

            <!-- Level summary -->
            <Border Style="{StaticResource OverlayPanel}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                    Padding="10,5" Visibility="{Binding InfoText, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding InfoText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
            </Border>
        </Grid>

        <!-- ── Properties panel ── -->
        <Border Grid.Column="1" Width="300" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsChecked, ElementName=PropertiesToggle, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="38" Margin="14,0,6,0">
                    <TextBlock Text="PROPERTIES" Style="{StaticResource Text.PanelHeader}" />
                    <Button Style="{StaticResource Button.Subtle}" HorizontalAlignment="Right" Padding="5"
                            controls:ControlAssist.Icon="{StaticResource Icon.Close}" controls:ControlAssist.IconSize="14"
                            ToolTip="Hide the properties panel" Click="HideProperties_Click" />
                </Grid>
                <Border DockPanel.Dock="Top" Style="{StaticResource Callout}" Margin="12,0,12,8"
                        Visibility="{Binding IsEditable, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Text="Read-only preview: this level can be inspected but edits can't be saved back to its archive." />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <local:LevelObjectPropertiesArea x:Name="propertiesArea"
                                                     IsEnabled="{Binding IsEditable}"
                                                     SelectedElement="{Binding SelectedElement, Mode=TwoWay}"
                                                     SelectedObject="{Binding SelectedObject, Mode=TwoWay}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
