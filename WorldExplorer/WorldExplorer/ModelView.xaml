<UserControl x:Class="WorldExplorer.ModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hvd="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Core.Wpf"
             xmlns:controls="clr-namespace:WorldExplorer.Controls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Background="{DynamicResource Brush.Viewport}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="Transparent" Name="trackballSource">
            <hvd:HelixViewport3D ClipToBounds="True" Name="viewport" IsChangeFieldOfViewEnabled="False"
                                 ShowViewCube="False" ShowCoordinateSystem="True">
                <hvd:SunLight />

                <ModelVisual3D x:Name="modelObject" />
            </hvd:HelixViewport3D>
        </Border>

        <!-- View tools -->
        <Border Style="{StaticResource OverlayPanel}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="normalsBox" Style="{StaticResource ToggleButton.Subtle}"
                              controls:ControlAssist.Icon="{StaticResource Icon.Normals}" ToolTip="Show vertex normals"
                              Checked="normalsBox_IsCheckedChanged" Unchecked="normalsBox_IsCheckedChanged" />
                <Button Style="{StaticResource Button.Subtle}" Click="Frame_Click"
                        controls:ControlAssist.Icon="{StaticResource Icon.Frame}" ToolTip="Frame the model (Ctrl+Home)" />
                <Button Style="{StaticResource Button.Subtle}" Click="Export_Click"
                        controls:ControlAssist.Icon="{StaticResource Icon.Export}"
                        ToolTip="Export the model as posed (glTF / OBJ)… (Ctrl+G)" />
            </StackPanel>
        </Border>

        <!-- Model info -->
        <Border Style="{StaticResource OverlayPanel}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                Padding="10,5" Visibility="{Binding InfoText, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding InfoText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
        </Border>

        <!-- Animation playback (only when an animation is applied) -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,1,0,0" Padding="10,6"
                Visibility="{Binding AnimData, Converter={StaticResource NullToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Name="playButton" Click="playButton_Click" Margin="0,0,10,0"
                        ToolTip="Play / pause the animation">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
                            <Setter Property="controls:ControlAssist.Icon" Value="{StaticResource Icon.Play}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="controls:ControlAssist.Icon" Value="{StaticResource Icon.Pause}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="{Binding FrameText}" Width="110" TextAlignment="Right"
                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                <Slider Name="frameSlider" Minimum="-1" Maximum="{Binding MaximumFrame}"
                        Value="{Binding CurrentFrame}" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
