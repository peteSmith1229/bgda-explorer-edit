<Window x:Class="WorldExplorer.ScriptRewardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Script Rewards" Height="420" Width="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Gold and XP take any value. Item names must be the same length or shorter than the current name (in-place edit). Leave a cell unchanged to skip it."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Apply" Width="90" Margin="0,0,8,0" Click="Apply_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
        <DataGrid x:Name="grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Function"  Binding="{Binding FunctionName}" IsReadOnly="True" Width="180"/>
                <DataGridTextColumn Header="Call"      Binding="{Binding ExternalName}" IsReadOnly="True" Width="120"/>
                <DataGridTextColumn Header="Current"   Binding="{Binding Current}"      IsReadOnly="True" Width="140"/>
                <DataGridTextColumn Header="New value" Binding="{Binding NewValue}"     Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>