<Window x:Class="WorldExplorer.ScriptRewardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Script Rewards" Height="420" Width="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Gold and XP take any value. Item names must be the same length or shorter than the current name (in-place edit). Leave a cell unchanged to skip it."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Apply" Width="90" Margin="0,0,8,0" Click="Apply_Click"/>
            <Button Content="Cancel" Width="90" IsCancel="True"/>
        </StackPanel>
        <DataGrid x:Name="grid" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Function" Binding="{Binding FunctionName}" IsReadOnly="True" Width="160"/>
                <DataGridComboBoxColumn Header="Call" Width="130"
                                        SelectedItemBinding="{Binding SelectedCall, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding CallOptions}"/>
                            <Setter Property="IsEnabled" Value="{Binding StructuralSafe}"/>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding CallOptions}"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="Current" Binding="{Binding Current}" IsReadOnly="True" Width="120"/>
                <DataGridTemplateColumn Header="New value" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding NewValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn Header="Remove" Width="60"
                                        Binding="{Binding Remove, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>