<UserControl x:Class="WorldExplorer.Views.ScriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:WorldExplorer.Controls"
             xmlns:infra="clr-namespace:WorldExplorer.Infrastructure"
             xmlns:local="clr-namespace:WorldExplorer"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=local:ScriptEditorViewModel}">
    <!-- A script's calls to the engine, with editable values. DataContext: ScriptEditorViewModel. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="Find_Executed" />
    </UserControl.CommandBindings>

    <UserControl.Resources>
        <Style x:Key="ArgumentBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Text" Value="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <EventSetter Event="KeyDown" Handler="ArgumentBox_KeyDown" />
            <EventSetter Event="LostKeyboardFocus" Handler="ArgumentBox_LostKeyboardFocus" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Modified}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One argument: its name, then a box to edit it (or the fixed value). -->
        <DataTemplate x:Key="ArgumentTemplate" DataType="{x:Type local:ScriptArgumentViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,3,16,3">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBox x:Name="Box" Style="{StaticResource ArgumentBox}" Width="90" />
                <Border x:Name="Fixed" Visibility="Collapsed" Background="{DynamicResource Brush.SurfaceAlt}"
                        CornerRadius="4" Padding="7,4" VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
                <Ellipse x:Name="ModifiedDot" Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Modified}" Visibility="Collapsed" ToolTip="{Binding ToolTip}" />
                <Border x:Name="ErrorIcon" Background="Transparent" Margin="5,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed" ToolTip="{Binding Error}">
                    <controls:GeometryIcon Data="{StaticResource Icon.Error}" Width="15" Height="15"
                                           Fill="{DynamicResource Brush.Danger}" />
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsText}" Value="True">
                    <Setter TargetName="Box" Property="Width" Value="210" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditable}" Value="False">
                    <Setter TargetName="Box" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Fixed" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter TargetName="ModifiedDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="ModifiedDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="12,5,10,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="220" VerticalAlignment="Center">
                        <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="28,3,6,3" MinHeight="28" KeyDown="FilterBox_KeyDown"
                                 controls:ControlAssist.Placeholder="Filter calls and values (Ctrl+F)" />
                        <controls:GeometryIcon Data="{StaticResource Icon.Search}" Width="14" Height="14"
                                               HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"
                                               Fill="{DynamicResource Brush.TextMuted}" />
                    </Grid>
                    <Separator Width="1" Height="20" Margin="8,0,6,0" />
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowRewardTools, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource Button.Subtle}" Command="{x:Static infra:AppCommands.RunTool}"
                                CommandParameter="{x:Static infra:GameTools.ScriptRewards}" Content="Rewards…"
                                controls:ControlAssist.Icon="{StaticResource Icon.Kind.Script}"
                                ToolTip="Edit Script Rewards: change gold, XP and items, or swap and remove reward calls" />
                        <Button Style="{StaticResource Button.Subtle}" Command="{x:Static infra:AppCommands.RunTool}"
                                CommandParameter="{x:Static infra:GameTools.InsertReward}" Content="Insert Reward…"
                                controls:ControlAssist.Icon="{StaticResource Icon.Add}" Margin="2,0,0,0"
                                ToolTip="Insert Reward at Call Site: add gold, XP or items just before a call" />
                    </StackPanel>
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding RevertCommand}" Content="Revert"
                            controls:ControlAssist.Icon="{StaticResource Icon.History}" Margin="2,0,0,0"
                            ToolTip="Put back the script as it was last saved (Ctrl+Z undoes this)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Engine calls" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Values that differ from the saved file. Save (Ctrl+S) to write them into the GOB.">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Modified}" VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ChangeSummary}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Why the script is read-only -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Callout}" Margin="12,10,12,0"
                Visibility="{Binding ReadOnlyReason, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" />
        </Border>

        <!-- How editing works, or why the last value wasn't applied -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Change a value and press Enter. Changes go into the open file: save (Ctrl+S) to write them into the GOB, or undo them with Ctrl+Z." />
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <controls:GeometryIcon Data="{StaticResource Icon.Error}" Width="14" Height="14" Margin="0,0,7,0"
                                           Fill="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Danger}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="140" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Functions -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="FUNCTIONS" Style="{StaticResource Text.Section}" FontSize="11"
                           Margin="16,12,0,6" />
                <ListBox ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}" Padding="6,0,6,6">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,5" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ScriptFunctionItem}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CallCount}" Margin="8,0,0,0"
                                           Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Title}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Calls -->
            <Grid Grid.Column="2">
                <ListBox x:Name="CallList" ItemsSource="{Binding CallsView}" Padding="6"
                         KeyboardNavigation.TabNavigation="Continue"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ScriptCallViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Background="Transparent" Margin="0,0,12,0"
                                            ToolTip="{Binding ToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Caption}"
                                                   FontFamily="{StaticResource Font.Mono}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />
                                        <controls:GeometryIcon Data="{StaticResource Icon.Info}" Width="13" Height="13"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Fill="{DynamicResource Brush.TextMuted}"
                                                               Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Function}" Style="{StaticResource Text.Caption}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Arguments}" Focusable="False"
                                              ItemTemplate="{StaticResource ArgumentTemplate}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Grid.Column="1" Text="No arguments" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasArguments, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
