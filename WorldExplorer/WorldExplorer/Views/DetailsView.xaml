<UserControl x:Class="WorldExplorer.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:WorldExplorer.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500">
    <!-- Decoded data / logs / hex dumps. DataContext: MainWindowViewModel. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="Find_Executed" />
    </UserControl.CommandBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="12,5,10,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="220" VerticalAlignment="Center">
                        <TextBox x:Name="FindBox" Padding="28,3,6,3" MinHeight="28"
                                 controls:ControlAssist.Placeholder="Find (Enter / Shift+Enter)"
                                 KeyDown="FindBox_KeyDown" />
                        <controls:GeometryIcon Data="{StaticResource Icon.Search}" Width="14" Height="14"
                                               HorizontalAlignment="Left" Margin="9,0,0,0"
                                               Fill="{DynamicResource Brush.TextMuted}" />
                    </Grid>
                    <TextBlock x:Name="FindStatus" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                               Margin="8,0,4,0" MinWidth="60" />
                    <Separator Width="1" Height="20" Margin="6,0" />
                    <ToggleButton x:Name="WrapButton" Style="{StaticResource ToggleButton.Subtle}"
                                  controls:ControlAssist.Icon="{StaticResource Icon.Wrap}" ToolTip="Word wrap"
                                  Click="Wrap_Click" />
                    <Button Style="{StaticResource Button.Subtle}" controls:ControlAssist.Icon="{StaticResource Icon.Copy}"
                            ToolTip="Copy all text" Click="Copy_Click" />
                    <Button Style="{StaticResource Button.Subtle}" controls:ControlAssist.Icon="{StaticResource Icon.Save}"
                            ToolTip="Save as a text file…" Click="Save_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DetailsTitle, TargetNullValue=Details}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DetailsLineCount}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <TextBox x:Name="Output" Style="{StaticResource TextBox.Code}"
                     Text="{Binding LogText, Mode=OneWay}" IsInactiveSelectionHighlightEnabled="True" />
            <TextBlock Text="Nothing to show for this item" Style="{StaticResource Text.Secondary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding LogText, Converter={StaticResource InverseNullToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
