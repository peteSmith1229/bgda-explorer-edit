<UserControl x:Class="WorldExplorer.Views.CutsceneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:WorldExplorer.Controls"
             xmlns:local="clr-namespace:WorldExplorer"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             d:DataContext="{d:DesignInstance Type=local:CutsceneEditorViewModel}">
    <!-- A cutscene's settings, cast and keyframes, with editable values. DataContext: CutsceneEditorViewModel. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    </UserControl.InputBindings>
    <UserControl.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="Find_Executed" />
    </UserControl.CommandBindings>

    <UserControl.Resources>
        <Style x:Key="ValueBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="{Binding BoxWidth}" />
            <Setter Property="Text" Value="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <EventSetter Event="KeyDown" Handler="ValueBox_KeyDown" />
            <EventSetter Event="LostKeyboardFocus" Handler="ValueBox_LostKeyboardFocus" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Modified}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A value's box (or the value itself, when read-only), its unit, and change or error markers. -->
        <DataTemplate x:Key="BoxTemplate" DataType="{x:Type local:CutsceneValueViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="Box" Style="{StaticResource ValueBox}" />
                <Border x:Name="Fixed" Visibility="Collapsed" Background="{DynamicResource Brush.SurfaceAlt}"
                        CornerRadius="4" Padding="7,4" VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
                <TextBlock Text="{Binding Unit}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           Margin="4,0,0,0" />
                <Ellipse x:Name="ModifiedDot" Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center"
                         Fill="{DynamicResource Brush.Modified}" Visibility="Collapsed" ToolTip="{Binding ToolTip}" />
                <Border x:Name="ErrorIcon" Background="Transparent" Margin="5,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed" ToolTip="{Binding Error}">
                    <controls:GeometryIcon Data="{StaticResource Icon.Error}" Width="15" Height="15"
                                           Fill="{DynamicResource Brush.Danger}" />
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditable}" Value="False">
                    <Setter TargetName="Box" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Fixed" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter TargetName="ModifiedDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="ModifiedDot" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A value with its name before the box. -->
        <DataTemplate x:Key="ValueTemplate" DataType="{x:Type local:CutsceneValueViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,3,16,3">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BoxTemplate}" />
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <Style x:Key="RowItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="12,5,10,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Grid Width="220" VerticalAlignment="Center"
                          Visibility="{Binding ShowKeyframes, Converter={StaticResource BoolToVisibility}}">
                        <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="28,3,6,3" MinHeight="28" KeyDown="FilterBox_KeyDown"
                                 controls:ControlAssist.Placeholder="Filter keyframes (Ctrl+F)" />
                        <controls:GeometryIcon Data="{StaticResource Icon.Search}" Width="14" Height="14"
                                               HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"
                                               Fill="{DynamicResource Brush.TextMuted}" />
                    </Grid>
                    <Separator Width="1" Height="20" Margin="8,0,6,0"
                               Visibility="{Binding ShowKeyframes, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding RevertCommand}" Content="Revert"
                            controls:ControlAssist.Icon="{StaticResource Icon.History}"
                            ToolTip="Put back the cutscene as it was last saved (Ctrl+Z undoes this)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cutscene" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Values and keyframes that differ from the saved file. Save (Ctrl+S) to write them into the GOB.">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Modified}" VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ChangeSummary}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Why the cutscene is read-only -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Callout}" Margin="12,10,12,0"
                Visibility="{Binding ReadOnlyReason, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" />
        </Border>

        <!-- How editing works, or why the last value wasn't applied -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.Chrome}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasError, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Change a value and press Enter. Changes go into the open file: save (Ctrl+S) to write them into the GOB, or undo them with Ctrl+Z." />
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <controls:GeometryIcon Data="{StaticResource Icon.Error}" Width="14" Height="14" Margin="0,0,7,0"
                                           Fill="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Danger}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="140" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Settings, cast, and whose keyframes to show -->
            <ListBox ItemsSource="{Binding SectionsView}" SelectedItem="{Binding SelectedSection}" Padding="6,4,6,6">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" FontSize="11"
                                           Margin="10,10,0,6" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,5" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CutsceneSection}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Margin="8,0,0,0"
                                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2">
                <!-- Settings -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="24,16,24,24" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="SOUND AND SUBTITLES" Style="{StaticResource Text.Section}" FontSize="11"
                                   Margin="2,0,0,8" />
                        <Border Style="{StaticResource Card}" Padding="18,10">
                            <ItemsControl ItemsSource="{Binding TextValues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:CutsceneValueViewModel}">
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.TextSecondary}"
                                                       VerticalAlignment="Top" Margin="0,5,12,0" />
                                            <StackPanel Grid.Column="1">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BoxTemplate}"
                                                                  HorizontalAlignment="Left" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="POSITION" Style="{StaticResource Text.Section}" FontSize="11" Margin="2,22,0,8" />
                        <Border Style="{StaticResource Card}" Padding="18,12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding PositionValues}" ItemTemplate="{StaticResource ValueTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="A point in the level stored with the scene, in world units. Its exact use isn't known; it may be where the player is placed when the scene ends." />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="OTHER" Style="{StaticResource Text.Section}" FontSize="11" Margin="2,22,0,8" />
                        <Border Style="{StaticResource Card}" Padding="18,12">
                            <StackPanel>
                                <TextBlock Text="{Binding OtherInfo}" FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="What these header values do isn't known yet, so they are kept as they are." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Cast -->
                <ListBox ItemsSource="{Binding Cast}" Padding="6" ItemContainerStyle="{StaticResource RowItem}"
                         KeyboardNavigation.TabNavigation="Continue"
                         Visibility="{Binding ShowCast, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CutsceneActorViewModel}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Style="{StaticResource Text.Caption}"
                                           FontFamily="{StaticResource Font.Mono}" Width="34" VerticalAlignment="Center" />
                                <ItemsControl ItemsSource="{Binding Values}" ItemTemplate="{StaticResource ValueTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Keyframes -->
                <Grid Visibility="{Binding ShowKeyframes, Converter={StaticResource BoolToVisibility}}">
                    <ListBox x:Name="KeyframeList" ItemsSource="{Binding KeyframesView}" Padding="6"
                             ItemContainerStyle="{StaticResource RowItem}" KeyboardNavigation.TabNavigation="Continue"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CutsceneKeyframeViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Modified}"
                                             VerticalAlignment="Center" HorizontalAlignment="Left"
                                             ToolTip="Changed or added since the last save"
                                             Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" />
                                    <ContentPresenter Grid.Column="1" Content="{Binding Time}"
                                                      ContentTemplate="{StaticResource BoxTemplate}"
                                                      VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Background="Transparent" ToolTip="{Binding ToolTip}" Margin="0,0,12,0">
                                        <controls:GeometryIcon Width="16" Height="16" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"
                                                               Fill="{DynamicResource Brush.TextSecondary}"
                                                               controls:IconAssist.DataKey="{Binding IconKey}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Who}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding What}" Style="{StaticResource Text.Caption}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Fields}" Focusable="False"
                                                  ItemTemplate="{StaticResource ValueTemplate}"
                                                  ItemsPanel="{StaticResource WrapPanelTemplate}" VerticalAlignment="Center" />
                                    <Border Grid.Column="3" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="4"
                                            Padding="7,4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                            ToolTip="{Binding ToolTip}"
                                            Visibility="{Binding HasRawText, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding RawText}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Border>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Button.Subtle}"
                                                controls:ControlAssist.Icon="{StaticResource Icon.Duplicate}"
                                                Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Copy this keyframe (the copy goes straight after it, at the same time)" />
                                        <Button Style="{StaticResource Button.Subtle}"
                                                controls:ControlAssist.Icon="{StaticResource Icon.Delete}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Delete this keyframe (Ctrl+Z undoes this)" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
