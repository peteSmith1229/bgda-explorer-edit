<UserControl x:Class="WorldExplorer.Views.EnhancementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WorldExplorer"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="560"
             d:DataContext="{d:DesignInstance Type=local:EnhancementsModel}">
    <!-- The Enhancements tab of Executable Tuning. DataContext: EnhancementsModel; each spell's card: SpellCard. -->
    <UserControl.Resources>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="Mark" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="60" />
            <Setter Property="Margin" Value="0,3,18,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Problem" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </Style>

        <!-- a further box of a rank's row (Inferno Arrow's, Entangle's): "blast [72]", "for [3] s", "slower [40] %" -->
        <DataTemplate DataType="{x:Type local:SpellValueBox}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Mark}" Margin="10,0,4,0" Text="{Binding Prefix}" />
                <TextBox Style="{StaticResource Field}" Width="40" Margin="0,3,0,3"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Tip}" />
                <TextBlock Style="{StaticResource Mark}" Text="{Binding Suffix}" />
            </StackPanel>
        </DataTemplate>

        <!-- one rank's boxes: "Rank 1  [4] – [8]", "Rank 1  [4] s", "Rank 1  +[10] % −[10] %", "Rank 1  [1] × [8] – [12]",
             "Rank 1  [10] – [15]  blast [64]  flames [48]  for [2] s  burning [1] – [2]" -->
        <DataTemplate DataType="{x:Type local:SpellRankRow}">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasThird, Converter={StaticResource BoolToVisibility}}">
                    <TextBox Style="{StaticResource Field}" Width="36" Margin="0,3,0,3"
                             Text="{Binding Third, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ThirdTip}" />
                    <TextBlock Style="{StaticResource Mark}" Margin="4,0,4,0" Text="{Binding ThirdSuffix}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Mark}" Text="{Binding FirstPrefix}" />
                <TextBox Style="{StaticResource Field}" Width="44" Margin="0,3,0,3"
                         Text="{Binding First, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding FirstTip}" />
                <TextBlock Style="{StaticResource Mark}" Text="{Binding FirstSuffix}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSecond, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Mark}" Text="{Binding Between}" />
                    <TextBox Style="{StaticResource Field}" Width="44" Margin="0,3,0,3"
                             Text="{Binding Second, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SecondTip}" />
                    <TextBlock Style="{StaticResource Mark}" Text="{Binding SecondSuffix}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding More}" Focusable="False"
                              Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- one spell's card -->
        <DataTemplate DataType="{x:Type local:SpellCard}">
            <Border Style="{StaticResource Card}" Margin="0,4,0,8" Padding="14,12">
                <StackPanel>
                    <CheckBox Content="{Binding Title}" FontWeight="SemiBold"
                              IsChecked="{Binding On}" IsEnabled="{Binding Usable}" ToolTip="{Binding Description}" />
                    <TextBlock Style="{StaticResource Help}" Margin="24,6,0,0" Text="{Binding Status}" />
                    <TextBlock Style="{StaticResource Help}" Margin="24,0,0,0" Text="{Binding Description}" />

                    <StackPanel Margin="24,4,0,0" IsEnabled="{Binding On}">
                        <TextBlock Text="SETTINGS" Style="{StaticResource Heading}" />
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Price" />
                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="The level-up price: 0 to 30, priced as the game prices its own feats (16, as Ball Lightning, makes the ranks cost 16, 17, 19, 21 and 25 feat points; 0 makes every rank free)." />
                            <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Mana a cast takes"
                                       Visibility="{Binding HasMana, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Grid.Column="3" Style="{StaticResource Field}" Text="{Binding Mana, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Above 0 and at most 100." Visibility="{Binding HasMana, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource FieldLabel}" Text="Ranks"
                                       Visibility="{Binding HasRankCount, Converter={StaticResource BoolToVisibility}}" />
                            <TextBox Grid.Column="5" Style="{StaticResource Field}" Text="{Binding RankCount, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="How many ranks the level-up screen offers: 1 (the game's description: +1 mana a level) to 5. Each rank adds 1 mana for every level she gains once she has it."
                                     Visibility="{Binding HasRankCount, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Help}" Text="{Binding ManaNote}"
                                   Visibility="{Binding ManaNote, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Style="{StaticResource Help}" Text="{Binding RankCostText}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,4" Text="{Binding ValuesCaption}"
                                   Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Ranks}" Visibility="{Binding HasValues, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="The tested settings" Click="SpellDefaults_Click" Margin="0,0,12,4" ToolTip="{Binding DefaultsTip}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Problem}" Text="{Binding SettingsProblem}"
                                   Visibility="{Binding SettingsProblem, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,2,14,8">
            <TextBlock Style="{StaticResource Help}" Text="Additions to the game that work with or without three players. Each one is turned on or off by itself here, and taking one out puts the game's own code back exactly. Nothing is written until you save." />

            <TextBlock Text="NEW FEATS: SPELLS BORROWED FROM THE GAME'S MONSTERS, AND THE GAME'S OWN CUT FEATS" Style="{StaticResource Heading}" Margin="0,8,0,6" />
            <TextBlock Style="{StaticResource Help}" Text="{Binding StateText}" />
            <TextBlock Style="{StaticResource Help}" Text="Each is a feat on its hero's level-up screen. Five are spells borrowed from the game's monsters, and Entangle is the game's own vines, which nothing in it casts; Power Attack, Sorcerer's Blood and Inferno Arrow are the game's own feats, which it never offers. The spells, Power Attack and Inferno Arrow have 5 ranks, cost mana like the game's own spells, and the HUD shows their icons and their numbers for the rank. Sorcerer's Blood is passive: it adds to Adrianna's mana as she gains levels." />
            <ItemsControl ItemsSource="{Binding Spells}" Focusable="False" />

            <TextBlock Text="NAMES AND ICONS" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Help}" Text="{Binding NamesStatus}" />
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Open ICONS.LMP…" Margin="8,0,0,0" Click="OpenIcons_Click"
                        ToolTip="ICONS.LMP, in the game's data folder, holds the HUD's spell icons." />
                <TextBlock Style="{StaticResource Help}" VerticalAlignment="Center" Margin="0" Text="{Binding IconStatus}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Help}" Text="GTEXT.LMP and ICONS.LMP are saved after the executable, each where you say: put them in your game image with it." />

            <TextBlock Text="ROOM FOR NEW FEATS" Style="{StaticResource Heading}" />
            <TextBlock Style="{StaticResource Help}" Text="{Binding PoolText}" />
            <TextBlock Style="{StaticResource Help}" Text="That code is loaded with the rest of the game, so nothing is copied at start-up and the executable keeps its size. The three-player patch never touches it, so three players can be turned on or off on their tab with any of these in." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
