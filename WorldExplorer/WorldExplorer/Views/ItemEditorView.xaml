<UserControl x:Class="WorldExplorer.Views.ItemEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WorldExplorer"
             mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="560"
             d:DataContext="{d:DesignInstance Type=local:ItemEditorModel}">
    <!-- The Items tab of Executable Tuning. DataContext: ItemEditorModel. -->
    <UserControl.Resources>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3,18,3" />
        </Style>
        <Style x:Key="Pick" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,3,18,3" />
            <Setter Property="DisplayMemberPath" Value="Text" />
            <Setter Property="SelectedValuePath" Value="Value" />
        </Style>
        <Style x:Key="Problem" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        </Style>
        <Style x:Key="Caution" TargetType="TextBlock" BasedOn="{StaticResource Problem}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Margin" Value="6,3,0,3" />
        </Style>
        <!-- a tick box per property bit; its tooltip says what the bit does -->
        <DataTemplate x:Key="BitTemplate">
            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSet, Mode=TwoWay}" ToolTip="{Binding Effect}"
                      Margin="0,3,16,3" MinWidth="130" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel />
        </ItemsPanelTemplate>
        <Style x:Key="SmallSwatch" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- a glow setting or style in a list: the halo and core colours, then its name -->
        <DataTemplate x:Key="GlowChoiceTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource SmallSwatch}" Background="{Binding HaloSwatch}" />
                <Border Style="{StaticResource SmallSwatch}" Margin="0,0,6,0" Background="{Binding CoreSwatch}" />
                <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <TextBlock Style="{StaticResource Help}" Margin="0,8,0,0" Text="{Binding ItemsProblem}"
                   Visibility="{Binding IsSupported, Converter={StaticResource InverseBoolToVisibility}}" />

        <TabControl Visibility="{Binding IsSupported, Converter={StaticResource BoolToVisibility}}">

            <!-- ═══════════════════════════════ Items ═══════════════════════════════ -->
            <TabItem Header="Items">
                <DockPanel Margin="0,4,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Open GTEXT.LMP…" Margin="8,0,0,0" Click="OpenNames_Click" />
                        <TextBlock Style="{StaticResource Help}" VerticalAlignment="Center" Margin="0" Text="{Binding NamesStatus}" />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="380" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="470" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <!-- added items: after the game's 81, in the room the three-player patch frees -->
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button DockPanel.Dock="Left" Content="Add item" Click="AddItem_Click" IsEnabled="{Binding CanAddItems}"
                                        ToolTip="Adds a copy of the selected item after the last one, under a new name: set it up, then put its name in a shop list to sell it. Three-player executables only: the room is the space the three-player patch frees after the item table." />
                                <Button DockPanel.Dock="Left" Content="Remove item" Margin="6,0,0,0" Click="RemoveItem_Click" IsEnabled="{Binding CanRemoveSelected}"
                                        ToolTip="Removes the selected added item. The added items after it move down a place, and saves keep items by their number." />
                                <TextBlock Style="{StaticResource Help}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding CapacityText}" />
                            </DockPanel>
                            <DataGrid x:Name="itemGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                      SelectionMode="Single" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="22">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <TextBlock Text="●" Foreground="{DynamicResource Brush.Modified}" HorizontalAlignment="Center"
                                                               ToolTip="Edited" Visibility="{Binding IsEdited, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center"
                                                               ToolTip="{Binding Problem}" Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="34" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                                    <DataGridTextColumn Header="Shown as" Binding="{Binding ShownName}" Width="150" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" Width="120" />
                                    <DataGridTextColumn Header="Damage" Binding="{Binding DamageText}" Width="64" />
                                    <DataGridTextColumn Header="Armour" Binding="{Binding ArmourText}" Width="60" />
                                    <DataGridTextColumn Header="Shop price" Binding="{Binding ValueText}" Width="80" />
                                    <DataGridTextColumn Header="Weight" Binding="{Binding WeightText}" Width="58" />
                                    <DataGridTemplateColumn Header="Glow" Width="84">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" ToolTip="Its own glow setting (glow styles, Glow tab)">
                                                    <Border Style="{StaticResource SmallSwatch}" Background="{Binding GlowHaloSwatch}" />
                                                    <Border Style="{StaticResource SmallSwatch}" Margin="0,0,4,0" Background="{Binding GlowCoreSwatch}" />
                                                    <TextBlock Text="{Binding GlowText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Modifiers" Binding="{Binding ModifiersText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10"
                                Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel DataContext="{Binding SelectedItem}" Margin="0,0,8,4">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Undo changes" Click="RevertItem_Click"
                                                ToolTip="Puts this item's boxes back as they are in the executable." />
                                        <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                            <Run Text="  #" Foreground="{DynamicResource Brush.TextMuted}" /><Run Text="{Binding Index, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Help}" Margin="0,6,0,0" Text="{Binding NameHint}"
                                               Visibility="{Binding HasNameHint, Converter={StaticResource BoolToVisibility}}" />

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Item name" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" IsEnabled="{Binding CanRename}"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="The name item text uses (shops, levels, scripts): longsword+1+fire. Only the unused scroll records and added items can be renamed." />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Shown as" />
                                        <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource Field}" Margin="0,3,0,3" IsEnabled="{Binding NamesLoaded}"
                                                 Text="{Binding ShownName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="The English name the game shows (GTEXT.LMP). Items with the same item name share it." />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Category" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Pick}" IsEnabled="{Binding CanChangeCategory}"
                                                  ItemsSource="{x:Static local:ItemRow.CategoryChoices}" SelectedValue="{Binding Category}"
                                                  ToolTip="Which inventory list it goes in. Only the unused scroll records and added items can change." />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Slot" />
                                        <ComboBox Grid.Row="1" Grid.Column="3" Style="{StaticResource Pick}" Margin="0,3,0,3" IsEnabled="{Binding CanChangeSlot}"
                                                  ItemsSource="{Binding SlotChoices}" SelectedValue="{Binding Slot}"
                                                  ToolTip="Where it is worn or held." />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Stance" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Pick}" IsEnabled="{Binding IsWeapon}"
                                                  ItemsSource="{x:Static local:ItemRow.StanceChoices}" SelectedValue="{Binding Stance}"
                                                  ToolTip="How a weapon is held and swung (its animations), and its value weight. The sorceress can't wield two-handed swords, axes or hammers." />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Damage type" />
                                        <ComboBox Grid.Row="2" Grid.Column="3" Style="{StaticResource Pick}" Margin="0,3,0,3"
                                                  ItemsSource="{x:Static local:ItemRow.DamageTypeChoices}" SelectedValue="{Binding DamageType}"
                                                  ToolTip="The kind of hit, which monster resistances count against." />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Damage min" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding DamageMin, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Damage max" />
                                        <TextBox Grid.Row="3" Grid.Column="3" Style="{StaticResource Field}" Margin="0,3,0,3" Text="{Binding DamageMax, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="+N" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Enchantment, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="0 to 15. Every one of these items has it; a +N in item text is OR-ed with it (+1 and +2 make +3)." />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Armour" />
                                        <TextBox Grid.Row="4" Grid.Column="3" Style="{StaticResource Field}" Margin="0,3,0,3" Text="{Binding Armour, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Armour class of the piece; each +N adds 1, rusty takes 1 off." />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Price" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="The base price of armour and other items. Weapons, rings and amulets are priced from their damage and bonuses instead." />
                                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Weight" />
                                        <TextBox Grid.Row="5" Grid.Column="3" Style="{StaticResource Field}" Margin="0,3,0,3" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Stack size" />
                                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding StackSize, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="How many one pickup or purchase gives (arrows: 20)." />
                                        <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Looks" />
                                        <TextBox Grid.Row="6" Grid.Column="3" Style="{StaticResource Field}" Margin="0,3,0,3" Text="{Binding Looks, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="How many models in a row from Model it can use (1 to 7). Each one made gets one: better materials pick later ones." />

                                        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Model" />
                                        <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Held items: the first model (Models tab). Body armour, gloves, boots and helmets: the ARMOR.YAK entry worn (the next one is the enchanted look)." />
                                        <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Pickup model" />
                                        <TextBox Grid.Row="7" Grid.Column="3" Style="{StaticResource Field}" Margin="0,3,0,3" Text="{Binding PickupModel, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="The model on the ground and in the inventory (Models tab)." />

                                        <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Glow" />
                                        <ComboBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3,0,3" IsEnabled="{Binding CanEditGlow}"
                                                  ItemsSource="{Binding GlowChoices}" SelectedValuePath="Value" SelectedValue="{Binding Glow}"
                                                  ItemTemplate="{StaticResource GlowChoiceTemplate}"
                                                  ToolTip="With glow styles (Glow tab): Automatic glows as the rules say; a style is this item's own, used when it has +N or a modifier a rule looks for; Never doesn't glow." />
                                    </Grid>

                                    <TextBlock Style="{StaticResource Problem}" Text="{Binding Problem}"
                                               Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Style="{StaticResource Caution}" Text="{Binding Warning}"
                                               Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Style="{StaticResource Help}" Margin="0,8,0,0" Text="{Binding Preview}" />

                                    <TextBlock Text="MODIFIERS" Style="{StaticResource Heading}" />
                                    <TextBlock Style="{StaticResource Help}" Text="Every one of these items has the modifiers ticked here; item text adds more. Hover over one to see what it does." />
                                    <ItemsControl ItemsSource="{Binding ModifierBits}" ItemTemplate="{StaticResource BitTemplate}"
                                                  ItemsPanel="{StaticResource WrapItems}" />

                                    <TextBlock Text="KIND" Style="{StaticResource Heading}" />
                                    <TextBlock Style="{StaticResource Help}" Text="Bits the game never names: what the item is made of and what kind it is. They pick names (Mithral or Darkwood), random modifiers and drops." />
                                    <ItemsControl ItemsSource="{Binding KindBits}" ItemTemplate="{StaticResource BitTemplate}"
                                                  ItemsPanel="{StaticResource WrapItems}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ═══════════════════════════════ Models ═══════════════════════════════ -->
            <TabItem Header="Models">
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}" Text="Each model is a .vif mesh and a .tex texture in EQUIPMNT.LMP, which the game loads by these names. Point a model at another model's files, or at new files you have added to EQUIPMNT.LMP (Add Entry… in the main window; a recoloured texture can be made with Export and Import PNG…). A name only this model uses is rewritten in place and must fit; a name other models share can only become a name some model already has. Models 49 (the maul), 58 and 101 (the scroll) are used by no item." />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Open EQUIPMNT.LMP…" Margin="8,0,0,0" Click="OpenEquipment_Click" />
                        <TextBlock Style="{StaticResource Help}" VerticalAlignment="Center" Margin="0" Text="{Binding EquipmentStatus}" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Models}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" IsReadOnly="True" Width="40" />
                            <DataGridTextColumn Header="Model (.vif)" Width="170"
                                                Binding="{Binding Vif, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Texture (.tex)" Width="170"
                                                Binding="{Binding Tex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Used by" Binding="{Binding UsedBy}" IsReadOnly="True" Width="260" />
                            <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" IsReadOnly="True" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ═══════════════════════════════ Shops ═══════════════════════════════ -->
            <TabItem Header="Shops">
                <Grid>
                    <TextBlock Style="{StaticResource Help}" Margin="0,8,0,0" Text="{Binding ShopsProblem}"
                               Visibility="{Binding ShopsSupported, Converter={StaticResource InverseBoolToVisibility}}" />
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding ShopsSupported, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Help}" Text="What each shop sells, as item text: an item name, then +N and modifier words joined by '+' (longsword+masterwork+2+fire). Bartley's list is used in the tavern, Branoch's in the mine camp and Sleyvas's everywhere else; on Extreme every shop sells the Extreme list and random items instead. The game's own item names cost nothing; other new text, added items' names among it, has to fit in the shops' text area (about 400 bytes more than the game uses)." />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Shop" />
                            <ComboBox Style="{StaticResource Pick}" MinWidth="320" ItemsSource="{x:Static local:ItemEditorModel.ShopStocks}"
                                      SelectedValue="{Binding SelectedShopStock}" />
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="TRY ITEM TEXT" Style="{StaticResource Text.Section}" Margin="0,0,0,4" />
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Left" Width="300" Text="{Binding TryText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Words the game knows: fire, ice, shock, fireburst, iceburst, shockburst, wound, keen, speed, superhaste, disruption, defense, elven, fine, masterwork, mithril, adamantine, rusty, protection, strength, dexterity, constitution, intelligence, healthregeneration, magicregeneration, and numbers 1-15; with the Corrosive patch (Corrosive page) also acid and acidburst." />
                                    <TextBlock Style="{StaticResource Help}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding TryResult}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding ShopRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" IsReadOnly="True" Width="40" />
                                <DataGridTextColumn Header="List" Binding="{Binding ListText}" IsReadOnly="True" Width="80" />
                                <DataGridTextColumn Header="Item text" Width="260"
                                                    Binding="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="In the game" Binding="{Binding Result}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" IsReadOnly="True" Width="260">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════ Glow ═══════════════════════════════ -->
            <TabItem Header="Glow">
                <!-- The page doesn't scroll sideways (like Loot & effects): with infinite width the help would never
                     wrap, and the rules grid couldn't size its columns. Only the styles, which are wider than a narrow
                     window, have their own sideways scroll bar. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,14,8">
                        <TextBlock Text="ENCHANT GLOW" Style="{StaticResource Heading}" Margin="0,4,0,6" />
                        <TextBlock Style="{StaticResource Help}" Text="{Binding GlowStatus}" />
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Use glow styles" Click="UseGlowStyles_Click" IsEnabled="{Binding CanTurnOnGlowStyles}" Margin="0,0,8,4"
                                    Visibility="{Binding GlowStylesOn, Converter={StaticResource InverseBoolToVisibility}}"
                                    ToolTip="Puts the glow styles code in the executable when you save, in place of the game's own glow function (and the debug starting kit nothing uses). With nothing changed, items glow exactly as in the game." />
                            <Button Content="Back to the game's own glow" Click="UseGameGlow_Click" Margin="0,0,8,4"
                                    Visibility="{Binding GlowStylesOn, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Takes glow styles out when you save: the game's glow function and debug kit go back, and every enchanted item glows in style 0's colours again." />
                            <Button Content="Ready-made: the game's own glow" Click="GlowPresetGame_Click" Margin="0,0,8,4" IsEnabled="{Binding GlowStylesUsable}"
                                    ToolTip="Every style the game's own dark blue, no rules and every item automatic: glow styles that look just like the game." />
                            <Button Content="Ready-made: the tested set" Click="GlowPresetTested_Click" Margin="0,0,8,4" IsEnabled="{Binding GlowStylesUsable}"
                                    ToolTip="The styles and rules tried in the game: Frost and Icy Burst icy blue, Shock yellow, Flaming orange, Wounding red, Keen silver, Disruption pale gold, Speed green, of Defence no glow; every short sword purple and the warhammer never." />
                        </WrapPanel>

                        <TextBlock Text="STYLES" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Help}" Text="A style is two layers drawn round the item: a large faint halo and a small bright core, as red, green and blue from 0 to 255. Both are added to the scene, so dark colours look faint. Strength is how strongly a layer shows at full power (the game's 64 and 72): an item with no power shows 60% of it, and each point of power adds 2.5%, up to all of it at 16 (+2 counts 2 points, +1 counts 8 because the game adds 7 for an odd +N, and modifiers 1 to 8). Without glow styles only style 0, the game's own colours, can be changed." />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Width="96" Text="Style" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Width="232" Text="Halo: red, green, blue, strength" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Width="232" Text="Core: red, green, blue, strength" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Width="196" Text="Copy colours from" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Used by" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding GlowStyles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1" IsEnabled="{Binding IsEditable}">
                                                <TextBlock Style="{StaticResource FieldLabel}" Width="96" Text="{Binding Name}" />
                                                <TextBox Width="38" Margin="0,0,3,0" Text="{Binding HaloR, UpdateSourceTrigger=PropertyChanged}" ToolTip="Halo red, 0 to 255" />
                                                <TextBox Width="38" Margin="0,0,3,0" Text="{Binding HaloG, UpdateSourceTrigger=PropertyChanged}" ToolTip="Halo green, 0 to 255" />
                                                <TextBox Width="38" Margin="0,0,3,0" Text="{Binding HaloB, UpdateSourceTrigger=PropertyChanged}" ToolTip="Halo blue, 0 to 255" />
                                                <TextBox Width="38" Margin="6,0,0,0" Text="{Binding HaloStrength, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding StrengthEditable}"
                                                         ToolTip="Halo strength at full power, 0 to 255 (the game's 64)" />
                                                <Button Style="{StaticResource Button.Swatch}" Background="{Binding HaloSwatch}" Margin="6,3,12,3" Tag="Halo"
                                                        Click="GlowSwatch_Click" ToolTip="Halo colour: click to pick one" />
                                                <TextBox Width="38" Margin="0,0,3,0" Text="{Binding CoreR, UpdateSourceTrigger=PropertyChanged}" ToolTip="Core red, 0 to 255" />
                                                <TextBox Width="38" Margin="0,0,3,0" Text="{Binding CoreG, UpdateSourceTrigger=PropertyChanged}" ToolTip="Core green, 0 to 255" />
                                                <TextBox Width="38" Margin="0,0,3,0" Text="{Binding CoreB, UpdateSourceTrigger=PropertyChanged}" ToolTip="Core blue, 0 to 255" />
                                                <TextBox Width="38" Margin="6,0,0,0" Text="{Binding CoreStrength, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding StrengthEditable}"
                                                         ToolTip="Core strength at full power, 0 to 255 (the game's 72)" />
                                                <Button Style="{StaticResource Button.Swatch}" Background="{Binding CoreSwatch}" Margin="6,3,12,3" Tag="Core"
                                                        Click="GlowSwatch_Click" ToolTip="Core colour: click to pick one" />
                                                <ComboBox Width="186" Margin="0,0,10,0" ItemsSource="{x:Static local:ItemEditorModel.GlowColourPresets}" DisplayMemberPath="Name"
                                                          SelectedItem="{Binding ColourPreset, Mode=TwoWay}" ToolTip="Copies a ready-made set of colours (and the game's strengths) into this style." />
                                                <TextBlock Style="{StaticResource Help}" Margin="0" VerticalAlignment="Center" Text="{Binding UsedBy}" />
                                                <TextBlock Style="{StaticResource Problem}" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Problem}"
                                                           Visibility="{Binding Problem, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Text="RULES" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Help}" Text="{Binding GlowRulesText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="Add rule" Click="AddGlowRule_Click" IsEnabled="{Binding CanAddGlowRule}"
                                    ToolTip="Adds a rule after the selected one: tick what it looks for below and pick its glow." />
                            <Button Content="Remove rule" Margin="6,0,0,0" Click="RemoveGlowRule_Click" IsEnabled="{Binding CanEditSelectedGlowRule}" />
                            <Button Content="Move up" Margin="6,0,0,0" Click="MoveGlowRuleUp_Click" IsEnabled="{Binding CanEditSelectedGlowRule}"
                                    ToolTip="Earlier rules win: an item with Frost and Disruption glows as the first rule that looks for either." />
                            <Button Content="Move down" Margin="6,0,0,0" Click="MoveGlowRuleDown_Click" IsEnabled="{Binding CanEditSelectedGlowRule}" />
                        </StackPanel>
                        <DataGrid x:Name="glowRuleGrid" ItemsSource="{Binding GlowRules}" SelectedItem="{Binding SelectedGlowRule, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  SelectionMode="Single" HorizontalAlignment="Left" IsEnabled="{Binding GlowStylesOn}"
                                  PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <!-- Fixed widths only: a DataGrid sizes a star (*) column from its viewport, and while it has
                                 no usable width (as when this page scrolled sideways) it squeezes every column to its
                                 minimum, leaving the cells empty. -->
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" IsReadOnly="True" Width="34" />
                                <DataGridTextColumn Header="Items with any of" Binding="{Binding Summary}" IsReadOnly="True" Width="320">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding Summary}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Glow" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding StyleChoices}" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Style, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemTemplate="{StaticResource GlowChoiceTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" IsReadOnly="True" Width="300">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,8,0,0" IsEnabled="{Binding GlowStylesOn}"
                                Visibility="{Binding SelectedGlowRule, Converter={StaticResource NullToVisibility}}">
                            <StackPanel DataContext="{Binding SelectedGlowRule}">
                                <TextBlock Style="{StaticResource Text.Section}" Margin="0,0,0,4">
                                    <Run Text="RULE " /><Run Text="{Binding Position, Mode=OneWay}" /><Run Text=" LOOKS FOR ITEMS WITH ANY OF THESE" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding ModifierBits}" ItemTemplate="{StaticResource BitTemplate}"
                                              ItemsPanel="{StaticResource WrapItems}" />
                                <TextBlock Text="KINDS" Style="{StaticResource Heading}" Margin="0,8,0,4" />
                                <TextBlock Style="{StaticResource Help}" Text="A kind matches plain items too. To colour a kind of item only when it's enchanted, set those items' glow (below) instead." />
                                <ItemsControl ItemsSource="{Binding KindBits}" ItemTemplate="{StaticResource BitTemplate}"
                                              ItemsPanel="{StaticResource WrapItems}" />
                                <TextBlock Style="{StaticResource Caution}" Text="{Binding Warning}"
                                           Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="GLOW FOR A GROUP OF ITEMS" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Help}" Text="Gives every item of a group the same glow setting (each item's own is on the Items tab). An item with its own style glows in it only when it has +N or a modifier a rule looks for, so this colours a kind of item only when it's enchanted." />
                        <WrapPanel IsEnabled="{Binding GlowStylesOn}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Set" />
                            <ComboBox Width="320" Margin="0,3,12,3" ItemsSource="{x:Static local:ItemEditorModel.GlowGroups}"
                                      SelectedItem="{Binding SelectedGlowGroup, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="to" />
                            <ComboBox Width="240" Margin="0,3,12,3" ItemsSource="{Binding ItemGlowChoices}" SelectedValuePath="Value"
                                      SelectedValue="{Binding GroupGlow, Mode=TwoWay}" ItemTemplate="{StaticResource GlowChoiceTemplate}" />
                            <Button Content="Set" Click="SetGroupGlow_Click" Margin="0,3,0,3" />
                            <TextBlock Style="{StaticResource Help}" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding GroupGlowResult}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{Binding GlowGroupMembers}" />

                        <TextBlock Text="TRY ITEM TEXT" Style="{StaticResource Heading}" />
                        <DockPanel>
                            <TextBox DockPanel.Dock="Left" Width="300" Text="{Binding GlowTryText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Item text as the shops use it, such as longsword+2+ice: how it would glow, and why." />
                            <TextBlock Style="{StaticResource Help}" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding GlowTryResult}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Margin="0,10,0,0" Text="Where the glow shows: weapons and shields in a character's hands, the turning models in the shop and inventory lists, and items lying in the level. Worn body armour, helmets, gloves and boots never glow on a character (their models can't take a glow), only in the lists. Next to an item on the ground, the game's white pick-up pulse shows instead." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Corrosive ═══════════════════════════════ -->
            <TabItem Header="Corrosive">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,14,8">
                        <TextBlock Text="CORROSIVE AND CORROSIVE BURST" Style="{StaticResource Heading}" Margin="0,4,0,6" />
                        <TextBlock Style="{StaticResource Help}" Text="Two weapon modifiers with acid damage, on property bits the game leaves unused. Corrosive (item text +acid) adds acid to every hit, as Flaming adds fire. Corrosive Burst (+acidburst) does that too, and a critical hit with it does more acid, splashes like the acid arrow and poisons the target, as Flaming Burst sets it alight. They are priced and count for glow like Flaming and Flaming Burst, and the item card shows an acid drop after the element icons. Tick them on an item (Items page), sell them in a shop or put them in a random-loot list (Loot &amp; effects): the Corrosive patch that makes the game use them goes in when you save." />
                        <TextBlock Style="{StaticResource Help}" Text="{Binding CorrosiveStatus}" />
                        <TextBlock Style="{StaticResource Problem}" Margin="0,0,0,6" Text="{Binding CorrosiveProblem}"
                                   Visibility="{Binding CorrosiveProblem, Converter={StaticResource NullToVisibility}}" />
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Use the Corrosive patch" Click="UseCorrosive_Click" IsEnabled="{Binding CanTurnOnCorrosive}" Margin="0,0,8,4"
                                    Visibility="{Binding CorrosiveOn, Converter={StaticResource InverseBoolToVisibility}}"
                                    ToolTip="Puts the patch in when you save even while nothing in the executable uses Corrosive: for item text in levels and scripts (chests, rewards), which WorldExplorer can't see." />
                            <Button Content="Take Corrosive out" Click="RemoveCorrosive_Click" IsEnabled="{Binding CanTurnOffCorrosive}" Margin="0,0,8,4"
                                    Visibility="{Binding CorrosiveOn, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Takes the patch out of the executable when you save (the game's code goes back as it was), the names out of GTEXT.LMP and the acid drop out of INVENTRY.LMP. Only when nothing in the executable has Corrosive or Corrosive Burst; levels and scripts that name them would then make plain weapons." />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{Binding CorrosiveUsersText}" />

                        <TextBlock Text="SETTINGS" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Help}" Text="The dice and the poison, the same for every Corrosive weapon. The tested settings are the ones tried in the game: 1-6 acid on every hit (as Flaming's fire), 1-10 for each step of a critical hit's multiplier (as Flaming Burst's), and 5 seconds of poison, 1 when the target resists acid. Poison takes a twentieth of the target's health (1 to 5 points) every 32 frames while it lasts, and tints it green; a critical hit never shortens poison that is already running." />
                        <Grid HorizontalAlignment="Left" IsEnabled="{Binding CorrosiveUsable}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Acid on every hit: 1 to" />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding CorrosiveDie, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="The die of the acid every hit with Corrosive or Corrosive Burst adds: 1 to 1000 (tested: 6, as Flaming's fire)." />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="Critical hit, per step: 1 to" />
                            <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource Field}" Margin="0,3,0,3" Text="{Binding CorrosiveCriticalDie, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Corrosive Burst's extra acid on a critical hit, rolled once for each step of the multiplier above 1: 1 to 1000 (tested: 10, as Flaming Burst's)." />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Poison, seconds" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding CorrosivePoison, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="How long a critical hit with Corrosive Burst poisons the target: 0 to 60 seconds (tested: 5)." />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabel}" Text="When it resists acid" />
                            <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource Field}" Margin="0,3,0,3" Text="{Binding CorrosiveResistedPoison, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="The poison's seconds when the target resists acid: 0 up to the poison's own time (tested: 1). A target immune to acid isn't poisoned." />
                        </Grid>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="The tested settings" Click="CorrosiveDefaults_Click" IsEnabled="{Binding CorrosiveUsable}" Margin="0,0,12,4"
                                    ToolTip="Puts the settings tried in the game back: 6, 10, 5 and 1." />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Problem}" Text="{Binding CorrosiveSettingsProblem}"
                                   Visibility="{Binding CorrosiveSettingsProblem, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Style="{StaticResource Help}" Text="{Binding CorrosiveSettingsText}" />

                        <TextBlock Text="NAMES AND THE ITEM CARD" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Help}" Text="{Binding CorrosiveNamesStatus}" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Open INVENTRY.LMP…" Margin="8,0,0,0" Click="OpenInventry_Click"
                                    ToolTip="INVENTRY.LMP, in the game's data folder, holds the inventory's pictures and the item card's icons." />
                            <TextBlock Style="{StaticResource Help}" VerticalAlignment="Center" Margin="0" Text="{Binding CorrosiveIconStatus}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="GTEXT.LMP and INVENTRY.LMP are saved after the executable, each where you say: put them in your game image with it." />

                        <TextBlock Text="ACID GLOW" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Help}" Text="With glow styles, Corrosive weapons can glow yellow-green: a style in the acid colours (the first one after those in use) and a first rule that gives it to Corrosive and Corrosive Burst, the other rules moving down. Glow styles are turned on if they are off. Without this, Corrosive weapons glow like any enchanted weapon." />
                        <WrapPanel>
                            <Button Content="Add the acid glow" Click="AddAcidGlow_Click" IsEnabled="{Binding CanAddAcidGlow}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Help}" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding AcidGlowResult}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════ Loot & effects ═══════════════════════════════ -->
            <TabItem Header="Loot &amp; effects">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,4,14,8">
                        <TextBlock Text="MATERIALS" Style="{StaticResource Heading}" Margin="0,4,0,6" />
                        <TextBlock Style="{StaticResource Help}" Text="How much each material multiplies a weapon's damage (the last one an item has wins). The game loads each with one instruction, so a value is rounded to one that fits: 1.5, 2, 2.25, 2.5, 3 and the like are exact." />
                        <DataGrid ItemsSource="{Binding Materials}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" HorizontalAlignment="Left" MinWidth="520" PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Material" Binding="{Binding Name}" IsReadOnly="True" Width="170" />
                                <DataGridTextColumn Header="Damage ×" Width="90" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" IsReadOnly="True" Width="60" />
                                <DataGridTextColumn Header="" Binding="{Binding Note}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="STANCE WEIGHTS" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Help}" Text="How much a weapon's stance counts in its price: the damage is multiplied by this before the price is worked out." />
                        <DataGrid ItemsSource="{Binding StanceWeights}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" HorizontalAlignment="Left" MinWidth="520" PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stance" Binding="{Binding Name}" IsReadOnly="True" Width="170" />
                                <DataGridTextColumn Header="Weight" Width="90" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" IsReadOnly="True" Width="60" />
                                <DataGridTextColumn Header="" Binding="{Binding Note}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="ENCHANT GLOW" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Help}" Text="The enchant glow is on the Glow tab: the game's own colours (style 0), and glow styles that give each item, and each group of modifiers, colours of its own." />

                        <TextBlock Text="RANDOM LOOT MODIFIERS" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Help}" Text="When the game makes a random item (drops, chests, Extreme shop stock) it picks entries from one of these lists and adds them: a +N, or one modifier. An entry that appears twice is picked twice as often. On Extreme, the +N is then raised while the item stays within the drop's budget." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="List" />
                            <ComboBox Style="{StaticResource Pick}" MinWidth="220" ItemsSource="{x:Static local:ItemEditorModel.LootLists}"
                                      SelectedValue="{Binding SelectedLootList}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding LootRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" HorizontalAlignment="Left" MinWidth="760" PreviewMouseWheel="Grid_PreviewMouseWheel">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Position}" IsReadOnly="True" Width="40" />
                                <DataGridComboBoxColumn Header="Adds" Width="200" ItemsSource="{x:Static local:ItemEditorModel.LootChoices}"
                                                        DisplayMemberPath="Text" SelectedValuePath="Value"
                                                        SelectedValueBinding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="What it does" Binding="{Binding Meaning}" IsReadOnly="True" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
