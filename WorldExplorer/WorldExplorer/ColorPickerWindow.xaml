<Window x:Class="WorldExplorer.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Pick a Colour" SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="Channel" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">
        <StackPanel Orientation="Horizontal">
            <!-- Saturation (left to right) and brightness (top to bottom) for the chosen hue -->
            <Grid x:Name="SvArea" Width="240" Height="200" Cursor="Cross" ClipToBounds="True"
                  MouseLeftButtonDown="SvArea_MouseDown" MouseMove="SvArea_MouseMove" MouseLeftButtonUp="Area_MouseUp">
                <Rectangle x:Name="HueFill" Fill="Red" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="Black" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="12" Height="12" Stroke="White" StrokeThickness="2">
                        <Ellipse.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- Hue -->
            <Grid x:Name="HueArea" Width="22" Height="200" Margin="10,0,0,0" Cursor="Hand" ClipToBounds="True"
                  MouseLeftButtonDown="HueArea_MouseDown" MouseMove="HueArea_MouseMove" MouseLeftButtonUp="Area_MouseUp">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueThumb" Width="22" Height="6" BorderBrush="White" BorderThickness="2" CornerRadius="2">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.9" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>

            <!-- New and current colour, and the numbers -->
            <StackPanel Margin="18,0,0,0" Width="150">
                <Grid Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="NewSwatch" CornerRadius="3,0,0,3" BorderThickness="1,1,0,1"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" ToolTip="The new colour" />
                    <Border Grid.Column="1" x:Name="OldSwatch" CornerRadius="0,3,3,0" BorderThickness="0,1,1,1" Cursor="Hand"
                            BorderBrush="{DynamicResource Brush.BorderStrong}" ToolTip="The colour before: click to go back to it"
                            MouseLeftButtonUp="OldSwatch_Click" />
                </Grid>
                <Grid Margin="0,2,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="New" Style="{StaticResource Text.Caption}" />
                    <TextBlock Grid.Column="1" Text="Current" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Red" Style="{StaticResource Label}" />
                    <TextBox Grid.Column="1" x:Name="RBox" Style="{StaticResource Channel}" TextChanged="Channel_TextChanged"
                             ToolTip="Red, 0 to 255" />
                    <TextBlock Grid.Row="1" Text="Green" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="GBox" Style="{StaticResource Channel}" TextChanged="Channel_TextChanged"
                             ToolTip="Green, 0 to 255" />
                    <TextBlock Grid.Row="2" Text="Blue" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="BBox" Style="{StaticResource Channel}" TextChanged="Channel_TextChanged"
                             ToolTip="Blue, 0 to 255" />
                    <TextBlock Grid.Row="3" Text="Hex" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="HexBox" Style="{StaticResource Channel}" Width="84" TextChanged="Hex_TextChanged"
                             ToolTip="The colour as #RRGGBB" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Ready-made colours -->
        <ItemsControl x:Name="Presets" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel MaxWidth="440" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Button.Swatch}" Width="26" Height="20" Margin="0,0,6,6"
                            Background="{Binding Brush}" ToolTip="{Binding Name}" Click="Preset_Click" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="ProblemText" Foreground="{DynamicResource Brush.Danger}" FontSize="12" Margin="0,4,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="90" IsDefault="True"
                    Style="{StaticResource Button.Accent}" Click="Ok_Click" />
            <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
