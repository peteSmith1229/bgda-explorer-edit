<Window x:Class="WorldExplorer.EntryNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner"
        Title="Add Entry"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=entryNameBox}">

    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="Name inside the archive" Margin="0,0,0,6" />
        <TextBox x:Name="entryNameBox" MaxLength="55" TextChanged="EntryNameBox_TextChanged" />
        <TextBlock x:Name="validationText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />

        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Include the extension (e.g. mymodel.vif). Names are stored as ASCII, at most 55 characters." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="okButton" Content="Add" MinWidth="90" IsDefault="True"
                    Style="{StaticResource Button.Accent}" Click="OkButton_Click" />
            <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
